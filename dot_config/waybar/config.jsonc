{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "custom/vpn",
    "custom/updates",
    "cpu",
    "memory",
    "temperature",
    "custom/gpu",
    "custom/llm",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "idle_inhibitor",
    "clock",
    "custom/notification",
    "tray"
  ],
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "format-alt": "{:%A %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "on-click": "mode",
      "on-click-right": "today",
      "on-click-middle": "reset",
      "format": {
        "months": "<span color='#ffcc99'><b>{}</b></span>",
        "days": "<span color='#c0caf5'>{}</span>",
        "weeks": "<span color='#7dcfff'>W{}</span>",
        "weekdays": "<span color='#e0af68'>{}</span>",
        "today": "<span color='#ff5370'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "{volume}% ",
    "scroll-step": 5,
    "on-click": "pwvucontrol"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {essid} ({ipaddr})",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "🌡️ {temperatureC}°C",
    "tooltip": true
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 300,
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "on-click": "alacritty -e yay -Syu"
  },
  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/wireguard_status.sh",
    "interval": 30,
    "format": "{}",
    "return-type": "json",
    "tooltip": true
  },
  "memory": {
    "format": "MEM {}%",
    "tooltip": true
  },
  "bluetooth": {
    "format": "BT",
    "format-connected": "BT {num_connections}",
    "format-on": "BT",
    "format-off": "BT-off",
    "format-disabled": "BT-dis",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },
  "idle_inhibitor": {
    "format": "INHIBIT",
    "tooltip": true
  },
  "custom/llm": {
    "exec": "~/.config/waybar/scripts/llm_status.sh",
    "interval": 10,
    "format": "{}",
    "return-type": "json",
    "tooltip": true
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu_vram.sh",
    "interval": 5,
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "on-click": "lact gui"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
