MODEL=/home/r1ppl3/models/Ornith-1.5-35B-A3B-IQ4_XS.gguf

# 2026-10-25: MoE 枠（HIP 版）
#   ornith-35b.env は Vulkan 指定のままだが、評価で使ったのは HIP（eval-ornith.env）
#   実測(HIP): T1 8.9s / prefill 902 tok/s @16K / decode 115(短) 57(16K) / VRAM 17.5GB
#   注意: T7 でサンドボックス外を書き換えた実績あり（無人実行には使わない）
BACKEND=hip

NGL=99
FA=on

CTX=65536

BATCH=1024
UBATCH=512

HOST=0.0.0.0
PORT=11435

REASONING_MODE=off
CACHE_K=q8_0
CACHE_V=q8_0

TEMP=0.8
TOP_P=0.95
TOP_K=40
MIN_P=0.05
REPEAT_PENALTY=1.05
PRESENCE_PENALTY=0.0

CACHE_RAM=0
PARALLEL=1

EXTRA_ARGS="--jinja"
