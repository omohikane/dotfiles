MODEL=/home/r1ppl3/models/G4-MeroMero-26B-A4B-IQ4_XS.gguf

# 2026-10-16: RX 7900 XTX (24GB) 向けに再調整。
#   実測 HIP   : prompt 3589 tok/s / gen 75.9 tok/s, VRAM CTX64k=16.8GB / 128k=17.9GB
#   実測 Vulkan: prompt 96 tok/s（37倍遅い）→ 誤起動防止のため BACKEND を固定
BACKEND=hip

NGL=99
FA=on

CTX=131072

BATCH=1024
UBATCH=512

HOST=0.0.0.0
PORT=11435

REASONING_MODE=off
CACHE_K=q8_0
CACHE_V=q8_0

TEMP=0.8
TOP_P=0.95
TOP_K=40
MIN_P=0.05
REPEAT_PENALTY=1.05
PRESENCE_PENALTY=0.0
CACHE_RAM=0
# 128k で VRAM の余裕を確保するため 1（PARALLEL=2 は KV が2倍になる）
PARALLEL=1
