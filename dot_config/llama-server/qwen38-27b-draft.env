MODEL=/home/r1ppl3/models/Qwen3.8-27B-UD-IQ4_XS.gguf

# 2026-10-25: 主力（高速プロファイル）
#   2B の draft（投機的デコード）を付けて decode を約2倍にする
#   実測: decode 79.9(短) / 69.2(16K)  ← draft なしは 55 / 33
#         draft 採択率 0.79〜0.85、prefill 895 tok/s @16K（-9%）
#   VRAM 22.8GB @64K。128K は載らないので長文は qwen38-27b.env を使う
BACKEND=hip

NGL=99
FA=on

CTX=65536

BATCH=1024
UBATCH=512

HOST=0.0.0.0
PORT=11435

REASONING_MODE=off
CACHE_K=q8_0
CACHE_V=q8_0

TEMP=0.8
TOP_P=0.95
TOP_K=40
MIN_P=0.05
REPEAT_PENALTY=1.05
PRESENCE_PENALTY=0.0

CACHE_RAM=0
PARALLEL=1

EXTRA_ARGS="--jinja --spec-draft-model /home/r1ppl3/models/OrcaCyber-Nano-1.0-AI-Defense-DFlash2-Q8_0.gguf --spec-draft-ngl 99"
