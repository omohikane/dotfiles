layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }

        children

        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="term" {
        pane command="fish"
    }

    tab name="edit" focus=true {
        pane command="fish"
    }

    tab name="ssh" {
        pane command="fish"
    }

    // 左: term(ターミナル) / 右: 上下に agent(エージェント用) と aux(ログ・テスト用)
    tab name="ai" {
        pane split_direction="vertical" {
            pane command="fish" name="term"
            pane split_direction="horizontal" {
                pane command="fish" name="agent"
                pane command="fish" name="aux"
            }
        }
    }
}
