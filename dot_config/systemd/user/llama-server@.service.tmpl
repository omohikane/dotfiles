[Unit]
Description=llama-server (%i)
After=network.target

[Service]
{{- if eq .host "server" }}
# server: ExecStart expands ${VAR} from this file
EnvironmentFile=%h/.config/llama-server/%i.env
{{- end }}
# client: do NOT export the env file. TEMP=0.8 in it segfaults HIP init
# (libamdhip64) on kernel 7.2.x; llama-run sources the file itself.
ExecStart={{ if eq .host "server" }}/usr/bin/llama-server \
  -m ${MODEL} -ngl ${NGL} --device ${DEVICE} \
  -fa ${FA} -c ${CTX} -b ${BATCH} -ub ${UBATCH} \
  --host ${HOST} --port ${PORT} \
  --reasoning ${REASONING_MODE} \
  --temp ${TEMP} \
  --top-p ${TOP_P} \
  --top-k ${TOP_K} \
  --min-p ${MIN_P} \
  --repeat-penalty ${REPEAT_PENALTY} \
  --presence-penalty ${PRESENCE_PENALTY} \
  --cache-ram ${CACHE_RAM} \
  --parallel ${PARALLEL} \
  --cache-type-k ${CACHE_K} \
  --cache-type-v ${CACHE_V} \
  $EXTRA_ARGS{{ else }}%h/.local/bin/llama-run %i{{ end }}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
