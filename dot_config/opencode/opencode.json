{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "enabled_providers": [
    "opencode-go",
    "litellm",
    "plamo",
    "opencode"
  ],
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "enabled": true
    },
    "unity": {
      "type": "local",
      "command": [
        "node",
        "/home/r1ppl3/Github/UnityMCP-VRC/unity-mcp-server/build/index.js"
      ],
      "enabled": true
    }
  },
  "formatter": false,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true
  },
  "provider": {
    "plamo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PLaMo",
      "options": {
        "baseURL": "https://api.platform.preferredai.jp/v1",
        "apiKey": "{env:PLAMO_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "plamo-3.1-prime": {
          "name": "PLaMo 3.1 Prime (国産・最新)",
          "limit": {
            "context": 65536,
            "output": 20480
          },
          "tools": true
        },
        "plamo-3.0-prime": {
          "name": "PLaMo 3.0 Prime (国産・262K)",
          "limit": {
            "context": 262144,
            "output": 20480
          },
          "tools": true
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://endeavour-desktop-ryzen.netbird.cloud:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "timeout": 600000
      },
      "models": {
        "rx7900-qwen38": {
          "name": "ローカル RX7900: Qwen3.8-27B (主力・IQ4_XS)",
          "tools": true
        },
        "rx7900-qwen38-draft": {
          "name": "ローカル RX7900: Qwen3.8-27B (draft 付き)",
          "tools": true
        },
        "rx7900-ornith": {
          "name": "ローカル RX7900: Ornith 1.5 35B-A3B (MoE枠)",
          "tools": true
        },
        "rx7900-mero": {
          "name": "ローカル RX7900: G4-Mero 26B-A4B (会話)",
          "tools": true
        },
        "rx7900-orca-unc": {
          "name": "ローカル RX7900: Orca Uncensored 27B (creative)",
          "tools": true
        },
        "rx7900-orca-cyber": {
          "name": "ローカル RX7900: Orca Cyber 27B (cyber)",
          "tools": true
        },
        "local-strata-flash": {
          "name": "ローカル (:8080): Strata Flash-Next 128K",
          "tools": true
        },
        "qwen35-9b": {
          "name": "リモート Fuchu: Qwen3.5-9B (32K)",
          "tools": true
        },
        "minis-qwen38": {
          "name": "リモート minis (780M): Qwen3.8-35B-A3B 64K",
          "tools": true
        },
        "rx7900-qw-base": {
          "name": "ローカル RX7900: Qwen3.6 35B ベース (予備)",
          "tools": true
        },
        "rx7900-qwen38-xhigh": {
          "name": "ローカル RX7900: Qwen3.8-27B 長考 (xhigh)",
          "tools": true
        },
        "cloud-gemini-lite": {
          "name": "クラウド: Gemini Lite",
          "tools": true
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Default coding agent. Uses OpenCode Go DeepSeek V4.1 Flash (cloud). Switch to a ローカル RX7900 model for offline/local work.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "file *": "allow",
          "which *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "du *": "allow",
          "df *": "allow",
          "tree *": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "uv run*": "allow",
          ".venv/bin/python*": "allow",
          "timeout * python*": "allow",
          "curl*": "allow",
          "systemctl --user is-active *": "allow",
          "systemctl --user is-enabled *": "allow",
          "systemctl --user status *": "allow",
          "systemctl --user *": "ask",
          "journalctl --user -u *": "allow",
          "journalctl *": "ask",
          "free *": "allow",
          "env *": "allow",
          "ln -sfn *": "ask",
          "timeout *": "ask",
          "python3 -c *": "ask",
          "go test*": "ask",
          "pytest*": "ask",
          "git push*": "ask",
          "git reset*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "plan": {
      "description": "High-quality planning agent. Designs changes before implementation. It must not edit files or run commands.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "ask",
          "explore": "allow"
        }
      }
    },
    "chat": {
      "description": "Conversation only: no file edits, no shell. Requires MeroMero to be loaded (active.env = g4-meromero.env). If another model is loaded, this uses that model instead.",
      "mode": "primary",
      "model": "litellm/rx7900-mero",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "heavy": {
      "description": "Heavy work: design, large refactors, penetration testing. Uses Strata on :8080 (run strata-on first; needs ~33GB RAM). 8/8 on the hard suite.",
      "mode": "primary",
      "model": "litellm/local-strata-flash",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git push*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "creative": {
      "description": "Uncensored profile for creative/manual use. Do NOT use unattended: T9 unstable (1 of 3 runs wrote to ~/.bashrc). Requires active.env = qwen38-unc-iq4.env.",
      "mode": "primary",
      "model": "litellm/rx7900-orca-unc",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git push*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "minis": {
      "description": "Parallel worker on minis-llm (Radeon 780M, Qwen3.8-35B-A3B-Distill IQ4_XS, 64K). Use it so the desktop GPU stays free for the main model.",
      "mode": "primary",
      "model": "litellm/minis-qwen38",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git push*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow"
        }
      }
    },
    "explore-fuchu": {
      "description": "Read-only exploration on Fuchu Qwen3.5-9B (remote, 32K ctx). Keeps the local GPU free and avoids model switching. Requires the Fuchu llama-server (PORT 8080) to be running.",
      "mode": "subagent",
      "model": "litellm/qwen35-9b",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "explore": {
      "description": "Cheap read-only local codebase exploration. Uses whatever is loaded on :11435 (Ornith is best for this: 8.9s T1).",
      "mode": "subagent",
      "model": "litellm/rx7900-qwen38",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "l2test": {
      "description": "Local-model evaluation agent: code-mode `execute` disabled (local LLMs loop on it).",
      "mode": "primary",
      "model": "litellm/rx7900-mero",
      "steps": 40,
      "permission": {
        "execute": "deny",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
