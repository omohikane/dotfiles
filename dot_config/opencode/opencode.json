{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/rx7900-mero",
  "small_model": "litellm/rx7900-mero",
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": ["uvx", "blender-mcp"],
      "enabled": true
    },
    "unity": {
      "type": "local",
      "command": ["node", "/home/r1ppl3/Github/UnityMCP-VRC/unity-mcp-server/build/index.js"],
      "enabled": true
    }
  },
  "formatter": false,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://endeavour-desktop-ryzen.netbird.cloud:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "timeout": 600000
      },
      "models": {
        "rx7900-mero": {
          "name": "RX7900 Mero",
          "tools": true
        },
        "rx7900-ornith": {
          "name": "RX7900 Ornith 35B",
          "tools": true
        },
        "rx7900-qw-base": {
          "name": "RX7900 Qwen Base",
          "tools": true
        },
        "rx7900-qwen38": {
          "name": "RX7900 Qwen3.8-27B Q3_K_M",
          "tools": true
        },
        "rx7900-qwen38-xhigh": {
          "name": "RX7900 Qwen3.8-27B xhigh",
          "tools": true
        },
        "meigao-coding": {
          "name": "Meigao Coding",
          "tools": true
        },
        "cloud-gemini-lite": {
          "name": "Gemini Lite",
          "tools": true
        },
        "cloud-deepseek-fast": {
          "name": "DeepSeek Fast",
          "tools": true
        },
        "cloud-deepseek-strong": {
          "name": "DeepSeek Strong",
          "tools": true
        },
        "local-strata-flash": {
          "name": "Strata Flash-Next IQ2_XS",
          "tools": true
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Default coding agent. Makes local edits and runs safe commands with approval.",
      "mode": "primary",
      "model": "litellm/rx7900-mero",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "file *": "allow",
          "which *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "du *": "allow",
          "df *": "allow",
          "tree *": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "uv run*": "allow",
          ".venv/bin/python*": "allow",
          "timeout * python*": "allow",
          "curl*": "allow",
          "systemctl --user is-active *": "allow",
          "systemctl --user is-enabled *": "allow",
          "systemctl --user status *": "allow",
          "systemctl --user *": "ask",
          "journalctl --user -u *": "allow",
          "journalctl *": "ask",
          "free *": "allow",
          "env *": "allow",
          "ln -sfn *": "ask",
          "timeout *": "ask",
          "python3 -c *": "ask",
          "go test*": "ask",
          "pytest*": "ask",
          "git push*": "deny",
          "git reset*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "plan": {
      "description": "High-quality planning agent. Designs changes before implementation. It must not edit files or run commands.",
      "mode": "primary",
      "model": "litellm/cloud-deepseek-fast",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "ask",
          "explore": "allow"
        }
      }
    },
    "explore": {
      "description": "Cheap read-only local codebase exploration. Use for finding files, symbols, dependencies, config, and project structure.",
      "mode": "subagent",
      "model": "litellm/rx7900-mero",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
