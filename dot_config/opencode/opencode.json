{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/rx6800-fable",
  "small_model": "litellm/rx6800-fable",
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "formatter": false,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "dummy",
        "timeout": 600000
      },
      "models": {
        "rx6800-chat": {
          "name": "RX6800 Chat",
          "tools": true
        },
        "rx6800-coding": {
          "name": "RX6800 Coding",
          "tools": true
        },
        "rx6800-fable": {
          "name": "RX6800 Fable",
          "tools": true
        },
        "rx6800-mero": {
          "name": "RX6800 Mero",
          "tools": true
        },
        "rx6800-devstral": {
          "name": "RX6800 Devstral",
          "tools": true
        },
        "rx6800-gemma": {
          "name": "RX6800 Gemma",
          "tools": true
        },
        "rx6800-apex": {
          "name": "RX6800 Apex",
          "tools": true
        },
        "rx6800-qw-base": {
          "name": "RX6800 Qwen Base",
          "tools": true
        },
        "meigao-coding": {
          "name": "Meigao Coding",
          "tools": true
        },
        "cloud-gemini-lite": {
          "name": "Gemini Lite",
          "tools": true
        },
        "cloud-deepseek-fast": {
          "name": "DeepSeek Fast",
          "tools": true
        },
        "cloud-deepseek-strong": {
          "name": "DeepSeek Strong",
          "tools": true
        }
      }
    }
  },
  "agent": {
    "build": {
      "description": "Default coding agent. Makes local edits and runs safe commands with approval.",
      "mode": "primary",
      "model": "litellm/rx6800-fable",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "file *": "allow",
          "which *": "allow",
          "stat *": "allow",
          "wc *": "allow",
          "du *": "allow",
          "df *": "allow",
          "tree *": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "uv run*": "allow",
          ".venv/bin/python*": "allow",
          "timeout * python*": "allow",
          "curl*": "allow",
          "go test*": "ask",
          "pytest*": "ask",
          "git push*": "deny",
          "git reset*": "ask",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "rm -rf *": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "ask",
          "explore": "allow",
          "general": "allow"
        }
      }
    },
    "plan": {
      "description": "High-quality planning agent. Designs changes before implementation. It must not edit files or run commands.",
      "mode": "primary",
      "model": "litellm/cloud-deepseek-fast",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "*": "ask",
          "explore": "allow"
        }
      }
    },
    "explore": {
      "description": "Cheap read-only local codebase exploration. Use for finding files, symbols, dependencies, config, and project structure.",
      "mode": "subagent",
      "model": "litellm/rx6800-chat",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
