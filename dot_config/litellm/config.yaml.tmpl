---

model_list:
  # === RX6800 ===
  - model_name: rx6800-qw-base
    litellm_params:
      model: openai/qwen3.6-35b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX6800: qwen3.6 Fable train ===
  # Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-IQ3_M.gguf
  - model_name: rx6800-fable
    litellm_params:
      model: openai/qwen36-27b-fable
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy


  # === RX6800: Gemma roleplay  ===
  # G4-MeroMero-26B-A4B-IQ4_XS.gguf
  - model_name: rx6800-mero
    litellm_params:
      model: openai/g4-meromero
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX6800: Coding devstral ===
  # Devstral-Small-2-24B-Instruct-2512-UD-Q4_K_XL.gguf
  - model_name: rx6800-devstral
    litellm_params:
      model: openai/devstral-24b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy


  # === RX6800: qwen3 heretic-APEX ===
  # Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-APEX-I-Compact.gguf
  - model_name: rx6800-apex
    litellm_params:
      model: openai/qwen36-heretic
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX6800: Gemma-uncensored ===
  # gemma-4-26B-A4B-it-ultra-uncensored-heretic-Q3_K_L.gguf
  - model_name: rx6800-gemma
    litellm_params:
      model: openai/gemma4-26b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === Meigao ===
  - model_name: meigao-coding
    litellm_params:
      model: openai/qwen3-coder-30b
      api_base: http://kokino-ai-series.netbird.cloud:11436/v1
      api_key: dummy

  # === X13 optional / future ===
  # FastFlowLM が OpenAI 互換になったら有効化
  # - model_name: x13-local
  #   litellm_params:
  #     model: openai/qwen3-small
  #     api_base: http://x13g6-endeavour.netbird.cloud:11437/v1
  #     api_key: dummy

  # === Cloud: Gemini ===
  - model_name: cloud-gemini-lite
    litellm_params:
      model: gemini/gemini-3.1-flash-lite
      api_key: os.environ/GEMINI_API_KEY

  # === Cloud: DeepSeek ===
  - model_name: cloud-deepseek-fast
    litellm_params:
      model: deepseek/deepseek-v4-flash
      api_key: os.environ/DEEPSEEK_API_KEY

  - model_name: cloud-deepseek-strong
    litellm_params:
      model: deepseek/deepseek-v4-pro
      api_key: os.environ/DEEPSEEK_API_KEY

  # === Cloud: OpenRouter optional ===
  # 今は常用 fallback には入れず、必要になったら明示選択用として有効化する。
  # Kimi K2.7 Code: coding / agentic coding / repo 作業用
  # GLM 5.2: heavy reasoning / long context / agentic workflow 用
  #
  # OpenRouter では Kimi K2.7 Code と GLM 5.2 の比較ページがあり、
  # benchmark / price / context length / features を比較できる。
  # https://openrouter.ai/compare/z-ai/glm-5.2/moonshotai/kimi-k2.7-code
  #
  # - model_name: cloud-or-kimi-code
  #   litellm_params:
  #     model: openrouter/moonshotai/kimi-k2.7-code
  #     api_key: os.environ/OPENROUTER_API_KEY
  #
  # - model_name: cloud-or-glm-strong
  #   litellm_params:
  #     model: openrouter/z-ai/glm-5.2
  #     api_key: os.environ/OPENROUTER_API_KEY

router_settings:
  num_retries: 1
  cooldown_time: 60
  allowed_fails: 1

#  fallbacks:
#    - sample:
#        - cloud-gemini-lite
#        - cloud-deepseek-fast


litellm_settings:
  request_timeout: 600
  drop_params: true
  set_verbose: false
  callbacks:
    - llama_model_switcher.llama_model_switcher
