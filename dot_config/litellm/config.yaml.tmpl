# vim:ft=yaml
# Managed by chezmoi
---

model_list:
  # === RX7900 ===
  - model_name: rx7900-qw-base
    litellm_params:
      model: openai/qwen3.6-35b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: Qwen3.8-27B ===
  # Qwen3.8-27B-UD-IQ4_XS.gguf (no-think 運用)
  - model_name: rx7900-qwen38
    litellm_params:
      model: openai/qwen38-27b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: Qwen3.8-27B xhigh（じっくり考える用）===
  # Qwen3.8-27B-UD-IQ4_XS.gguf + reasoning_effort=xhigh
  # 難しい問題をじっくり考えさせたい時に選択。~10 t/s と遅い
  - model_name: rx7900-qwen38-xhigh
    litellm_params:
      model: openai/qwen38-27b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: Gemma roleplay / 会話 ===
  # G4-MeroMero-26B-A4B-IQ4_XS.gguf / active.env = g4-meromero.env
  - model_name: rx7900-mero
    litellm_params:
      model: openai/g4-meromero
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: Ornith-1.5-35B-A3B（MoE 枠）===
  # IQ4_XS / active.env = ornith-hip.env / CTX 65536 (parallel 1)
  - model_name: rx7900-ornith
    litellm_params:
      model: openai/ornith-35b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: Qwen3.8-27B（主力プロファイル名。実体は active.env）===
  # qwen38-27b.env / qwen38-27b-draft.env / qwen38-unc-iq4.env のどれをロードしても良い
  - model_name: rx7900-qwen38-draft
    litellm_params:
      model: openai/qwen38-27b-draft
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # === RX7900: OrcaRouter 系（profile 名。実体は active.env が決める）===
  # Uncensored IQ4_XS / active.env = qwen38-unc-iq4.env
  - model_name: rx7900-orca-unc
    litellm_params:
      model: openai/qwen38-27b-uncensored
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy

  # OrcaSAQ-2 Cyber 27B / active.env = orca-cyber.env
  - model_name: rx7900-orca-cyber
    litellm_params:
      model: openai/orcasaq-2-27b
      api_base: http://endeavour-desktop-ryzen.netbird.cloud:11435/v1
      api_key: dummy


  # === minis-llm (Radeon 780M / Vulkan) ===
  # Qwen3.8-35B-A3B-Distill IQ4_XS, :8080, API キーは api-keys.env の MINIS_LLAMA_API_KEY
  - model_name: minis-qwen38
    litellm_params:
      model: openai/qwen38-35b-a3b
      api_base: http://minis-llm.netbird.cloud:8080/v1
      api_key: os.environ/MINIS_LLAMA_API_KEY

  # === Strata: Qwen3.8-Flash-Next IQ2_XS (ESP on) ===
  # Strata engine on :8080, OpenAI-compat, model name anything
  - model_name: local-strata-flash
    litellm_params:
      model: openai/qwen3.8-flash-next
      api_base: http://127.0.0.1:8080/v1
      api_key: dummy


  # === Fuchu-LLM-Server (Vega 56) ===
  # Qwen3.5-9B-UD-Q4_K_XL.gguf
  - model_name: qwen35-9b
    litellm_params:
      model: openai/qwen35-9b
      api_base: http://fuchu-llm-server.netbird.cloud:8080/v1
      api_key: dummy

  # === X13 optional / future ===
  # FastFlowLM が OpenAI 互換になったら有効化
  # - model_name: x13-local
  #   litellm_params:
  #     model: openai/qwen3-small
  #     api_base: http://x13g6-endeavour.netbird.cloud:11437/v1
  #     api_key: dummy

  # === Cloud: Gemini ===
  - model_name: cloud-gemini-lite
    litellm_params:
      model: gemini/gemini-3.1-flash-lite
      api_key: os.environ/GEMINI_API_KEY

  # === Cloud: DeepSeek ===
  - model_name: cloud-deepseek-fast
    litellm_params:
      model: deepseek/deepseek-v4-flash
      api_key: os.environ/DEEPSEEK_API_KEY

  - model_name: cloud-deepseek-strong
    litellm_params:
      model: deepseek/deepseek-v4-pro
      api_key: os.environ/DEEPSEEK_API_KEY

  # === Cloud: OpenRouter optional ===
  # 今は常用 fallback には入れず、必要になったら明示選択用として有効化する。
  # Kimi K2.7 Code: coding / agentic coding / repo 作業用
  # GLM 5.2: heavy reasoning / long context / agentic workflow 用
  #
  # OpenRouter では Kimi K2.7 Code と GLM 5.2 の比較ページがあり、
  # benchmark / price / context length / features を比較できる。
  # https://openrouter.ai/compare/z-ai/glm-5.2/moonshotai/kimi-k2.7-code
  #
  # - model_name: cloud-or-kimi-code
  #   litellm_params:
  #     model: openrouter/moonshotai/kimi-k2.7-code
  #     api_key: os.environ/OPENROUTER_API_KEY
  #
  # - model_name: cloud-or-glm-strong
  #   litellm_params:
  #     model: openrouter/z-ai/glm-5.2
  #     api_key: os.environ/OPENROUTER_API_KEY

general_settings:
  # netbird越しクライアントからのアクセス用。実値は ~/.config/secrets/api-keys.env で管理
  master_key: os.environ/LITELLM_MASTER_KEY

router_settings:
  num_retries: 1
  cooldown_time: 60
  allowed_fails: 1

#  fallbacks:
#    - sample:
#        - cloud-gemini-lite
#        - cloud-deepseek-fast


litellm_settings:
  request_timeout: 600
  drop_params: true
  set_verbose: false
  callbacks:
    - llama_model_switcher.llama_model_switcher
